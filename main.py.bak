import os
import argparse

from prompts import system_prompt
from call_function import available_functions, call_function

from dotenv import load_dotenv
from google import genai
from google.genai import types

def main():
    load_dotenv()
    api_key = os.environ.get("GEMINI_API_KEY")
    if api_key is None:
        raise RuntimeError("API Key is empty")

    client = genai.Client(api_key=api_key)

    parser = argparse.ArgumentParser(description="Chatbot")
    parser.add_argument("user_prompt", type=str, help="User prompt")
    parser.add_argument("--verbose", action="store_true", help="Enable verbose output")
    args = parser.parse_args()

    messages = [types.Content(role="user", parts=[types.Part(text=args.user_prompt)])]

    response = client.models.generate_content(
       model = "gemini-2.5-flash",
       contents = messages,
       config=types.GenerateContentConfig(tools=[available_functions], system_instruction=system_prompt),
    )

    if not response.usage_metadata:
        raise RuntimeError("usage_metadata is empty")

    if args.verbose:
        print(f"User prompt: {args.user_prompt}")
        print(f"Prompt tokens: {response.usage_metadata.prompt_token_count}")
        print(f"Response tokens: {response.usage_metadata.candidates_token_count}")
    if response.function_calls:
        function_results = []

        for function_call in response.function_calls:
            print(f"Calling function: {function_call.name}({function_call.args})")

            # Use call_function to execute the logic
            # This assumes your call_function returns a types.Content object
            function_call_content = call_function(function_call)

            # Validation requirements
            if not function_call_content.parts:
               raise Exception("Function call returned a Content object with no parts.")

            first_part = function_call_content.parts[0]

            if first_part.function_response is None:
                raise Exception("Part does not contain a function_response.")

            if first_part.function_response.response is None:
                raise Exception("FunctionResponse contains no response data.")

            # Save the valid part for the next model turn
            function_results.append(first_part)
    else:
        print(f"Response: {response.text}")


if __name__ == "__main__":
    main()
